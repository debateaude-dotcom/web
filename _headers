/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), camera=(), microphone=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; script-src 'self'; connect-src 'self' https://formspree.io; form-action https://formspree.io; base-uri 'self'; frame-ancestors 'self'

# Los nombres de archivo no llevan hash, así que "immutable" o un año de
# caché dejaría a los visitantes recurrentes con la versión antigua tras
# cualquier cambio. Plazos cortos y honestos:

/assets/*
  Cache-Control: public, max-age=604800

/js/*
  Cache-Control: public, max-age=3600

/styles.css
  Cache-Control: public, max-age=3600

# La web sigue accesible por su dirección técnica de Cloudflare. Que exista
# no molesta, pero si Google la indexa compite con debateaude.com por los
# mismos textos. Las etiquetas <link rel="canonical"> ya apuntan al dominio
# bueno; esto lo remata pidiendo a los buscadores que no indexen esa copia.
# (Lo definitivo es una Redirect Rule en el panel de Cloudflare: ver DOMINIO.md.)

https://web.debateaude.workers.dev/*
  X-Robots-Tag: noindex
